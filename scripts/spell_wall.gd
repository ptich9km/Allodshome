class_name SpellWall
extends SpellZone
## Стена заклинания (Wall_of_Fire / Wall_of_Earth) — настроенная разновидность
## общей зоны SpellZone.
##
## Вся логика (прямоугольник, урон по тику, блокировка клеток, снятие
## блокировки) живёт в SpellZone. Здесь только значения по умолчанию стены,
## чтобы SpellVFX.spawn_wall() и тесты продолжали работать со SpellWall.
##
## Раньше стена была кругом радиуса 72 px, а блокировала клетки 3 × 3: урон,
## картинка и преграда не совпадали. Теперь размер задаётся один раз — в клетках.

## Стена по решению игрока: 6 клеток вдоль и 2 ряда.
const DEFAULT_CELLS := Vector2i(6, 2)


func _init() -> void:
	style = "wall"
	cells = DEFAULT_CELLS
	mode = "damage"
