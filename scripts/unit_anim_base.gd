class_name UnitAnimBase
extends Node2D
## Общий базовый класс бэкендов анимации юнита: спрайт-листов (UnitAnim) и
## 2D-рига (RiggedAnim).
##
## ЗАЧЕМ НЕ ИНТЕРФЕЙС, А БАЗОВЫЙ КЛАСС. В GDScript нет интерфейсов, а игровой
## код обращается к анимации поимённо: `_anim.play(UnitAnim.Anim.IDLE)`,
## `_anim.advance(delta)`, `_anim.visual_height()`. Если поле объявлено как
## `var _anim: UnitAnim`, то ни типизация, ни рантайм не позволят положить туда
## RiggedAnim. Два выхода: снять тип (теряем статическую проверку, ровно то,
## чего требует конвенция проекта) или ввести общий базовый класс. Выбран
## второй — он сохраняет типизацию и делает замену бэкенда легальной операцией.
##
## САМА ПОВЕРХНОСТЬ ЗДЕСЬ — ЭТО КОНСТРАКТ, и он сторожится тестом
## tests/anim_contract_smoke.gd. Если метод нужен обоим бэкендам, он объявлен
## здесь; каждый решает, что делать. Метод, которого нет здесь, вызывать из
## общих мест НЕЛЬЗЯ — иначе один из бэкендов сорвётся в рантайме.
##
## ИМЯ УЗЛА. Игровой код ищет узел поимённо: `game.gd` берёт
## `u.get_node_or_null("UnitAnim")`, `spell_vfx` и `craft_vfx` — то же самое.
## Поэтому каждый бэкенд ставит себе `name = "UnitAnim"`, и подмена бэкенда
## невидима для потребителей.

## Блоки анимации. Наследуются обоими бэкендами, поэтому вызовы вида
## `UnitAnim.Anim.IDLE` продолжают работать после перехода на базовый класс.
enum Anim { IDLE, MOVE, ATTACK, DYING, DECAY }

## Число мировых направлений (компасных октант).
const FULL_DIRS := 8

# --- состояние, одинаковое для обоих бэкендов ---

## Набор вида: "heroes/swordsman", "heroes/pilot", ...
var set_name := ""
## Текущее МИРОВОЕ направление 0-7. Индексация КОНТРИКЛОКОВАЯ, 0 = север
## (вверх экрана): 0=север 7=северо-восток 6=восток 5=юго-восток 4=юг
## 3=юго-запад 2=запад 1=северо-запад. Считается из Game.unit_octant.
var dir := 0
## Текущий блок (Anim.*) и номер фазы внутри него.
var anim: int = 0
var anim_idx := 0
## Направление, к которому юнит доворачивается; -1 = доворачиваться не надо.
var target_dir := -1
## Множитель темпа (быстрее идёшь — чаще шагаешь).
var speed_scale := 1.0


## Настроить вид. Бэкенд без содержимого для набора обязан выйти молча и
## оставить `is_loaded()` == false, чтобы вызывающий код остался на листах.
func setup(_set: String) -> void:
	pass


## Запустить блок. `reset` форсирует перезапуск с первой фазы.
func play(_kind: int, _reset: bool = false) -> void:
	pass


## Продвинуть анимацию. true = блок доиграл (для одноразовых: атака, смерть,
## распад). Зацикленные блоки (стойка, ходьба) возвращают false всегда.
func advance(_delta: float) -> bool:
	return true


## Оставить последний кадр блока — «труп лежит», а не вернулся к началу цикла.
func freeze_last_frame(_kind: int) -> void:
	pass


## Задать направление по вектору скорости/взгляда. Поворот плавный.
func set_direction_vec(_dir_vec: Vector2) -> void:
	pass


## Высота текущего кадра в пикселях — по ней вешается шкала HP.
func sprite_height() -> float:
	return 0.0


## Рамка непрозрачного содержимого текущего кадра в координатах юнита
## (ноги ≈ 0, макушка — отрицательный y). Пустая рамка = «не знаю»,
## вызывающий код берёт приблизительную фигуру.
func content_rect() -> Rect2:
	return Rect2()


## Рамка тела по кадру стойки — для хит-бокса и дистанции боя.
func body_rect() -> Rect2:
	return Rect2()


## Высота с учётом масштаба юнита (tile_size): тролль вдвое выше.
func visual_height() -> float:
	return 0.0


## Один шаг поворота к `target_dir`. Отдельный метод, а не часть `_process`,
## чтобы поворот можно было шагать ЯВНОЙ дельтой в тестах: в headless у
## `await process_frame` дельта не набирает ROT_STEP_TIME, и проверка доворота
## без этого шага была бы фиктивно-зелёной.
func _advance_rotation(_delta: float) -> void:
	pass