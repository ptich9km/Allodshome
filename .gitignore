# Godot 4+ specific ignores
.godot/
*.godot/

# Temp/agent scratch
.qwen/
.agents/

# OS generated files
.DS_Store
Thumbs.db

# Godot Mono (if using C#)
.mono/
*.sln
*.csproj

# Export files
*.pck
*.exe
*.app
*.x86_64
*.wasm
*.html

# IDE
.vscode/
.idea/
*.import

# Python (скрипты-генераторы ассетов в tests/)
__pycache__/
*.pyc

# Генерируемый рендер карты для визуального контроля (tests/render_alm_png.gd).
# В коммите лежал устаревший кусок 4 КБ, а текущий рендер 128x128 = 14 МБ.
# Это выход dev-инструмента, а не ассет: пересоздаётся одной командой.
assets/maps/gen/gen_smart_01.png
assets/maps/gen/gen_smart_01.png.import

# Контактные листы ассетов - выход dev-инструмента для визуального контроля
# (tests/extract_chatgpt_armor.py --sheet, tests/gen_faction_armor_tint.py --sheet).
# Это не ассет игры: пересоздаётся одной командой, в Godot импортировать не нужно.
assets/items/base/_contact_sheet.png
assets/items/base/_contact_sheet.png.import
assets/items/base_w/_contact_sheet.png
assets/items/base_w/_contact_sheet.png.import
assets/items/faction/*/_contact_sheet.png
assets/items/faction/*/_contact_sheet.png.import
