    "voice.npc.merchant.1": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_merchant_1.mp3"
      ],
      "subtitle": "Снаряжение дорожает с каждой новой стражей у ворот."
    },
    "voice.npc.merchant.2": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_merchant_2.mp3"
      ],
      "subtitle": "Зелья всегда пригодятся: герои тоже умеют получать раны."
    },
    "voice.npc.merchant.3": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_merchant_3.mp3"
      ],
      "subtitle": "Магические книги есть только у тех, кто действительно читает магию."
    },
    "voice.npc.merchant.4": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_merchant_4.mp3"
      ],
      "subtitle": "Не торопись: хорошая броня окупается после второй вылазки."
    },
    "voice.npc.inn.1": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_inn_1.mp3"
      ],
      "subtitle": "Говорят, на севере всё больше диких зверей... Охрана у ворот не справляется."
    },
    "voice.npc.inn.2": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_inn_2.mp3"
      ],
      "subtitle": "В школе тренировок берут золотом за каждую ступень. Дорого, но быстро."
    },
    "voice.npc.inn.3": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_inn_3.mp3"
      ],
      "subtitle": "Торговец в лавке скупает всё, что принесёшь из-за стен. Вещи — по полцены."
    },
    "voice.npc.inn.4": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_inn_4.mp3"
      ],
      "subtitle": "Маги говорят, что настоящая сила — в книгах стихий. Остальным остаются свитки."
    },
    "voice.npc.inn.5": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_inn_5.mp3"
      ],
      "subtitle": "Слышал, за воротами люди пропадают. Особенно те, кто идёт без отряда."
    },
    "voice.npc.inn.6": {
      "bus": "Voice",
      "gain_db": -2.0,
      "pitch_jitter": 0.0,
      "files": [
        "voice/npc_inn_6.mp3"
      ],
      "subtitle": "Хороший наёмник стоит своих денег: сам себе и убийца, и щит."
    },
